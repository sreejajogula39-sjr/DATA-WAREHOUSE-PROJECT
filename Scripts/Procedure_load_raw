----lOAD PROCEDURE RAW--
CREATE OR ALTER PROCEDURE raw.load_raw as
begin
declare @start_time datetime,@end_time datetime,@batch_start_time datetime,@batch_end_time datetime;
  begin try
print '===================================';
print 'Loading Raw Layer';
print '===================================';

print '-----------------------------------';
print 'Loading CRM Tables';
print '-----------------------------------';
set @start_time=getdate();
print '>> Inserting Data Into raw.crm_cust_info';
Bulk insert raw.crm_cust_info
from 'C:\sql data ware house project\sql-data-warehouse-project-main\datasets\source_crm\cust_info.csv'
with (
 firstrow=2,
 fieldterminator=',',
 tablock
 );
set @end_time=getdate();
print'>> Load Duration: '+ cast(datediff(second,@start_time,@end_time) as nvarchar)+'seconds';

set @start_time=getdate();
print'>> Inserting Data into raw.crm_prod_info';
 Bulk insert raw.crm_prd_info
from 'C:\sql data ware house project\sql-data-warehouse-project-main\datasets\source_crm\prd_info.csv'
with (
 firstrow=2,
 fieldterminator=',',
 tablock
 );
 set @end_time=getdate();
print'>> Load Duration: '+ cast(datediff(second,@start_time,@end_time) as nvarchar)+'seconds';

 set @start_time=getdate();
 print'>> Inserting Data into raw.crm_sales_details';
 Bulk insert raw.crm_sales_details
from 'C:\sql data ware house project\sql-data-warehouse-project-main\datasets\source_crm\sales_details.csv'
with (
 firstrow=2,
 fieldterminator=',',
 tablock
 );
 set @end_time=getdate();
print'>> Load Duration: '+ cast(datediff(second,@start_time,@end_time) as nvarchar)+'seconds';

print '-----------------------------------';
print 'Loading ERP Tables';
print '-----------------------------------';
 set @start_time=getdate();
 print'>> Inserting Data into raw.erp_cust_az12';
 Bulk insert raw.erp_cust_az12
from 'C:\sql data ware house project\sql-data-warehouse-project-main\datasets\source_erp\CUST_AZ12.csv'
with (
 firstrow=2,
 fieldterminator=',',
 tablock
 );
 set @end_time=getdate();
print'>> Load Duration: '+ cast(datediff(second,@start_time,@end_time) as nvarchar)+'seconds';

 set @start_time=getdate();
  print'>> Inserting Data into raw.erp_loc_a101';
  Bulk insert raw.erp_loc_a101
from 'C:\sql data ware house project\sql-data-warehouse-project-main\datasets\source_erp\LOC_A101.csv'
with (
 firstrow=2,
 fieldterminator=',',
 tablock
 );
 set @end_time=getdate();
print'>> Load Duration: '+ cast(datediff(second,@start_time,@end_time) as nvarchar)+'seconds';

 set @start_time=getdate();
  print'>> Inserting Data into raw.erp_px_cat_g1v2';
   Bulk insert raw.erp_px_cat_g1v2
from 'C:\sql data ware house project\sql-data-warehouse-project-main\datasets\source_erp\PX_CAT_G1V2.csv'
with (
 firstrow=2,
 fieldterminator=',',
 tablock
 );
 set @end_time=getdate();
print'>> Load Duration: '+ cast(datediff(second,@start_time,@end_time) as nvarchar)+'seconds';

set @batch_end_time = getdate();
print'====================================';
print'Loading Raw Layer is completed';
print'- Total Duration: '+ cast(datediff(second,@batch_end_time,@batch_start_time) as nvarchar)+'seconds';
print'====================================';

 end try
 begin catch
 print '=========================================';
 print 'Error Occured During Raw Layer';
 print 'Error Message'+ Error_Message();
 print 'Error Message'+ cast(Error_Number() as nvarchar);
 print 'Error Message'+ cast(Error_state() as nvarchar);
 print '=========================================';
 end catch
 end
